{
  "name": "pi-diagram-workspace",
  "version": "0.6.1",
  "private": true,
  "description": "Workspace for the pi-diagram packages",
  "license": "MIT",
  "author": "mcuste",
  "homepage": "https://github.com/mcuste/pi-diagram#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcuste/pi-diagram.git"
  },
  "bugs": {
    "url": "https://github.com/mcuste/pi-diagram/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && node scripts/bundle.mjs && node scripts/copy-assets.mjs",
    "check": "pnpm quality && pnpm package:check && pnpm test && pnpm test:integration && pnpm deadcode && pnpm security",
    "deadcode": "knip",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "package:check": "pnpm build && publint packages/plugin",
    "prepare": "pnpm build",
    "preview": "pnpm build && node scripts/preview.mjs",
    "quality": "biome check .",
    "release": "node scripts/release.mjs",
    "security": "pnpm audit --audit-level high",
    "test": "pnpm build && pnpm -r test",
    "test:integration": "pnpm build && pnpm -r test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^26.2.0",
    "esbuild": "0.28.2",
    "knip": "6.32.2",
    "publint": "0.3.23",
    "typescript": "^7.0.2"
  },
  "knip": {
    "workspaces": {
      ".": {
        "entry": [
          "scripts/*.mjs"
        ],
        "project": [
          "scripts/*.mjs",
          "test/fixtures/*.mjs"
        ]
      },
      "packages/core": {
        "entry": [
          "test/**/*.test.mjs"
        ],
        "project": [
          "src/**/*.ts",
          "test/**/*.mjs"
        ]
      },
      "packages/d2": {
        "entry": [
          "test/**/*.test.mjs"
        ],
        "project": [
          "src/**/*.ts",
          "test/**/*.mjs"
        ]
      },
      "packages/display": {
        "entry": [
          "test/**/*.test.mjs"
        ],
        "project": [
          "src/**/*.ts",
          "test/**/*.mjs"
        ]
      },
      "packages/plugin": {
        "entry": [
          "test/**/*.test.mjs",
          "test/**/*.e2e.mjs"
        ],
        "project": [
          "src/**/*.ts",
          "test/**/*.mjs"
        ],
        "ignoreDependencies": [
          "@resvg/resvg-js",
          "@xmldom/xmldom"
        ]
      }
    }
  },
  "pi": {
    "extensions": [
      "./packages/plugin/dist/extension.js"
    ],
    "video": "https://cdn.jsdelivr.net/gh/mcuste/pi-diagram@main/docs/demo/pi-diagram-demo.mp4",
    "image": "https://cdn.jsdelivr.net/gh/mcuste/pi-diagram@main/docs/demo/pi-diagram-preview.png"
  },
  "omp": {
    "extensions": [
      "./packages/plugin/dist/extension.js"
    ],
    "video": "https://cdn.jsdelivr.net/gh/mcuste/pi-diagram@main/docs/demo/pi-diagram-demo.mp4",
    "image": "https://cdn.jsdelivr.net/gh/mcuste/pi-diagram@main/docs/demo/pi-diagram-preview.png"
  }
}
